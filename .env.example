# Copy to .env and adjust. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Leave unset to use SQLite (zero setup). docker-compose overrides this.
# DATABASE_URL=postgresql+psycopg2://retrace:retrace@localhost:5432/retrace

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
AUTO_SEED=true

# --- Demo account -----------------------------------------------------------
DEMO_EMAIL=demo@retrace.com
DEMO_PASSWORD=Demo@123

# --- Razorpay (optional) ----------------------------------------------------
# Test keys only. A live key is refused: the app checks for the rzp_test_ prefix.
# With these set, Checkout collects a real test payment and Safe Refund calls
# the real refund API against that payment id. Without them everything stays
# simulated and the Checkout card is hidden.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in the Razorpay dashboard when adding the webhook, then point it at
# POST /api/webhooks/razorpay for refund.processed / refund.failed events.
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
